<view class="tab-bar">
  <block wx:for="{{list}}" wx:key="key">
    <!-- 教练 tab：凸起圆钮特殊样式 -->
    <view wx:if="{{item.key === 'assistant'}}" class="tab-item coach-tab {{selected===item.fullIndex?'active':''}}" data-key="{{item.key}}" bindtap="switchTab">
      <view class="coach-circle">
        <view class="coach-icon"></view>
        <text class="coach-label">教练</text>
      </view>
    </view>
    <!-- 普通 tab -->
    <view wx:else class="tab-item {{selected===item.fullIndex?'active':''}}" data-key="{{item.key}}" bindtap="switchTab">
      <view class="tab-icon {{item.iconClass}}"></view>
      <text>{{item.text}}</text>
    </view>
  </block>
</view>

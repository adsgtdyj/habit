.page{min-height:100vh;background:#f1f5f9;display:flex;flex-direction:column}
.status-pad{flex:none}
.body{flex:1}
.section{background:#fff;margin:20rpx 24rpx;border-radius:24rpx;padding:32rpx 32rpx 8rpx;box-shadow:0 4rpx 20rpx rgba(99,102,241,0.06)}
.h1{font-size:34rpx;font-weight:700;color:#1e293b;margin-bottom:8rpx}
.updated{font-size:22rpx;color:#94a3b8;margin-bottom:24rpx}
.h2{font-size:28rpx;font-weight:700;color:#334155;margin:24rpx 0 12rpx}
.p{font-size:26rpx;line-height:1.7;color:#475569;margin-bottom:12rpx}
.li{font-size:26rpx;line-height:1.7;color:#475569;margin-bottom:10rpx;padding-left:8rpx}
.back-bar{flex:none;padding:16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));background:#f1f5f9}
.back-btn{height:84rpx;line-height:84rpx;text-align:center;background:#6366f1;color:#fff;border-radius:44rpx;font-size:30rpx;font-weight:600}